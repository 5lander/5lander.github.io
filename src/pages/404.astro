---
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/tokens.css';
// GitHub Pages serves this for any unknown path. Bilingual, no auto-redirect.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found · Lander Chicaiza</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <div class="wrap nf">
      <p class="nf-code">404</p>
      <h1>Page not found <span style="color:var(--ink-faint);font-weight:400;">· Página no encontrada</span></h1>
      <p>That page moved or never existed. — Esa página se movió o nunca existió.</p>
      <div class="nf-cta">
        <a class="btn btn-primary" href="/en/">← Home</a>
        <a class="btn btn-ghost" href="/es/">→ Inicio</a>
      </div>
    </div>
  </body>
</html>
