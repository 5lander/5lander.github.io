---
import { site, type Lang } from '../config';
import { t } from '../i18n/strings';
import { archApps, boundedContexts } from '../data';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang);
const n = s.noctis;
const sriScope = lang === 'en' ? 'In progress' : 'En curso';
---
<!-- HEADER -->
<header class="cs-head">
  <div class="wrap">
    <p class="cs-eyebrow">
      <span class="lead"><span class="amber"></span>{n.head.personal}</span>
      <span class="sep">·</span><span>{n.head.active}</span>
      <span class="sep">·</span><span>2026</span>
    </p>
    <h1>{n.head.title}</h1>
    <p class="cs-sub">{n.head.sub}</p>
    <div class="cs-meta">
      <div><div class="k">{n.head.roleK}</div><div class="v">{n.head.roleV}</div></div>
      <div><div class="k">{n.head.stackK}</div><div class="v">{n.head.stackV}</div></div>
      <div><div class="k">{n.head.repoK}</div><div class="v"><span class="privdot"></span>{n.head.repoV}</div></div>
      <div><div class="k">{n.head.dsK}</div><div class="v"><a href="/noctis-design-system/">{n.head.dsV}</a></div></div>
      <div><div class="k">{n.head.flowK}</div><div class="v"><a href="/noctis-design-system/ui_kits/core/index.html">{n.head.flowV}</a></div></div>
      <div><div class="k">{n.head.posK}</div><div class="v"><a href="/noctis-design-system/ui_kits/commerce/pos.html">{n.head.posV}</a></div></div>
    </div>
  </div>
</header>

<!-- 01 CONTEXT & PRODUCT -->
<section class="section">
  <div class="wrap">
    <p class="eyebrow">{n.s1.eyebrow}</p>
    <div class="two-col mb-lg">
      <div>
        <h2 class="h2">{n.s1.h2}</h2>
        <p class="lede">{n.s1.p}</p>
        <p class="s1-who">{n.s1.who}</p>
      </div>
      <div class="sidecard">
        <div><div class="k">{n.s1.servesK}</div><div class="v">{n.s1.servesV}</div></div>
        <hr />
        <div><div class="k">{n.s1.sriK}</div><div class="v">{n.s1.sriScopeLabel} <b style="color:var(--accent-text)">{sriScope}</b></div></div>
        <hr />
        <div><div class="k">{n.s1.modelK}</div><div class="v">{n.s1.modelV}</div></div>
      </div>
    </div>

    {/* Schematic UI mockups — on-brand wireframes, not screenshots of a shipped
        product. Swap for blurred real captures once the UI is presentable. */}
    <div class="shots">
      {n.s1.shots.map((sh, i) => (
        <div class="shot">
          <div class="shot-frame">
            <div class="shot-bar"><span></span><span></span><span></span><em class="shot-tab">{sh.t}</em></div>
            <div class="shot-body mock">
              {i === 0 && (
                <div class="m-pos">
                  <div class="m-grid">
                    {Array.from({ length: 6 }).map(() => (
                      <div class="m-tile"><span class="m-cap"></span><span class="m-bar w55"></span><span class="m-bar w35"></span></div>
                    ))}
                  </div>
                  <div class="m-cart">
                    <div class="m-line"><span class="m-bar w55"></span><span class="m-bar w20"></span></div>
                    <div class="m-line"><span class="m-bar w45"></span><span class="m-bar w20"></span></div>
                    <div class="m-line"><span class="m-bar w65"></span><span class="m-bar w20"></span></div>
                    <div class="m-total"><span>Total</span><b>$ ——</b></div>
                    <div class="m-btn">{lang === 'es' ? 'Cobrar' : 'Charge'}</div>
                  </div>
                </div>
              )}
              {i === 1 && (
                <div class="m-doc">
                  <div class="m-doc-head"><span class="m-logo"></span><span class="m-bar w35"></span></div>
                  <div class="m-doc-rows">
                    <div class="m-drow"><span class="m-bar w65"></span><span class="m-bar w20"></span></div>
                    <div class="m-drow"><span class="m-bar w45"></span><span class="m-bar w20"></span></div>
                    <div class="m-drow"><span class="m-bar w55"></span><span class="m-bar w20"></span></div>
                    <div class="m-drow"><span class="m-bar w45"></span><span class="m-bar w20"></span></div>
                  </div>
                  <div class="m-doc-tot"><span class="m-bar w35"></span><b>$ ——</b></div>
                  <div class="m-chip">SRI ✓</div>
                </div>
              )}
              {i === 2 && (
                <div class="m-tbl">
                  <div class="m-trow m-thead"><span class="m-bar w45"></span><span class="m-bar w20"></span><span class="m-hdot"></span></div>
                  <div class="m-trow"><span class="m-bar w55"></span><b class="m-num">128</b><span class="m-dot ok"></span></div>
                  <div class="m-trow"><span class="m-bar w45"></span><b class="m-num">34</b><span class="m-dot ok"></span></div>
                  <div class="m-trow"><span class="m-bar w65"></span><b class="m-num">6</b><span class="m-dot warn"></span></div>
                  <div class="m-trow"><span class="m-bar w45"></span><b class="m-num">0</b><span class="m-dot low"></span></div>
                </div>
              )}
            </div>
          </div>
          <div class="shot-cap">{sh.cap}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 02 ARCHITECTURE -->
<section class="section">
  <div class="wrap">
    <p class="eyebrow">{n.s2.eyebrow}</p>
    <h2 class="h2">{n.s2.h2}</h2>
    <p class="lede mb-lg">{n.s2.p}</p>

    {!site.monorepoNamesConfirmed && (
      <div class="ph-banner"><b>{s.ph.badge}</b><span>{s.ph.diagram}</span></div>
    )}
    <div class="diagram">
      <div class="diag-lbl">{n.s2.appsLbl}</div>
      <div class="diag-apps">
        {archApps.map((a) => <span class="diag-app">{a}</span>)}
        <span class="diag-app more">+3 e2e</span>
      </div>
      <div class="diag-arrow">↓</div>
      <div class="diag-lbl">{n.s2.libsLbl}</div>
      <div class="bc-grid">
        {boundedContexts.map((bc) => (
          <div class="bc">
            <div class:list={['bc-name', bc.tone]}>{bc.name}</div>
            <div class="bc-body">
              {bc.layers.map((ly) => {
                const cls = ly.kind === 'domain'
                  ? (bc.tone === 'green' ? 'domain-green' : 'domain-blue')
                  : 'plain';
                return <div class:list={['layer', cls]}>{ly.main} <span class="sub">{ly.sub}</span></div>;
              })}
            </div>
          </div>
        ))}
      </div>
      <div class="diag-arrow">↓</div>
      <div class="db-bar">
        <span class="name">PostgreSQL</span>
        <span class="rule">Row-Level Security · deny-by-default</span>
      </div>
    </div>
  </div>
</section>

<!-- 03 TENANT ISOLATION -->
<section class="section">
  <div class="wrap">
    <p class="eyebrow">{n.s3.eyebrow}</p>
    <h2 class="h2">{n.s3.h2}</h2>
    <p class="lede mb-lg">{n.s3.p}</p>

    <div class="flow">
      <div class="flow-node"><div class="t">{n.s3.n1t}</div><div class="s">{n.s3.n1s}</div></div>
      <div class="flow-arrow">→</div>
      <div class="flow-node"><div class="t">{n.s3.n2t}</div><div class="s">{n.s3.n2s}</div></div>
      <div class="flow-arrow">→</div>
      <div class="flow-node emph"><div class="t">{n.s3.n3t}</div><div class="s">{n.s3.n3s}</div></div>
    </div>

    <div class="code">
<pre><span class="tk-com">-- bind the tenant per transaction (tx-local, parameter-bound)</span>
<span class="tk-kw">SELECT</span> set_config(<span class="tk-str">'app.current_tenant'</span>, $tenant, <span class="tk-kw">true</span>);

<span class="tk-kw">ALTER TABLE</span> commerce.products <span class="tk-kw">ENABLE ROW LEVEL SECURITY</span>;
<span class="tk-kw">ALTER TABLE</span> commerce.products <span class="tk-kw">FORCE ROW LEVEL SECURITY</span>;

<span class="tk-kw">CREATE POLICY</span> tenant_isolation <span class="tk-kw">ON</span> commerce.products
  <span class="tk-kw">USING</span> (public.is_platform_admin()
     <span class="tk-kw">OR</span> tenant_id = public.current_tenant_id());
<span class="tk-com">-- unset GUC → current_tenant_id() IS NULL → deny by default</span></pre>
    </div>
  </div>
</section>

<!-- 04 EVIDENCE -->
<section class="section">
  <div class="wrap">
    <p class="eyebrow">{n.s4.eyebrow}</p>
    <h2 class="h2 mb-lg">{n.s4.h2}</h2>
    <div class="metrics">
      {n.s4.metrics.map((m) => (
        <div class="metric">
          <div class="metric-num">{m.n}</div>
          <div class="metric-label">{m.l}</div>
          <div class="metric-note-t">{m.note}</div>
        </div>
      ))}
      <div class="metric note"><div class="free">{n.s4.free}</div></div>
    </div>
  </div>
</section>

<!-- 05 DECISION RECORD -->
<section class="section" style="border-bottom:none;">
  <div class="wrap">
    <p class="eyebrow">{n.s5.eyebrow}</p>
    <div class="adr">
      <div>
        <div class="adr-id">{n.s5.id}</div>
        <div class="adr-title">{n.s5.title}</div>
        <span class="adr-status">{n.s5.status}</span>
      </div>
      <div class="adr-body">
        <div><div class="adr-k">{n.s5.decisionK}</div><p class="adr-v">{n.s5.decisionV}</p></div>
        <div><div class="adr-k">{n.s5.contextK}</div><p class="adr-v">{n.s5.contextV}</p></div>
        <div><div class="adr-k">{n.s5.consequenceK}</div><p class="adr-v">{n.s5.consequenceV}</p></div>
      </div>
    </div>
  </div>
</section>
