---
import { type Lang, other } from '../config';
import { t } from '../i18n/strings';
interface Props { lang: Lang; slug?: string; }
const { lang, slug = '' } = Astro.props;
const s = t(lang);
const home = `/${lang}/`;
const o = other(lang);
---
<nav class="nav">
  <div class="wrap nav-inner">
    <a class="nav-name" href={home}>Lander Chicaiza</a>
    <div class="nav-right">
      <div class="nav-links">
        <a href={`${home}#experience`}>{s.nav.experience}</a>
        <a href={`${home}#projects`}>{s.nav.projects}</a>
        <a href={`${home}#stack`}>{s.nav.stack}</a>
        <a href={`${home}#contact`}>{s.nav.contact}</a>
      </div>
      <div class="langtoggle" role="group" aria-label="Language">
        <a href={`/en/${slug}`} aria-current={lang === 'en' ? 'true' : 'false'} hreflang="en" lang="en">EN</a>
        <a href={`/es/${slug}`} aria-current={lang === 'es' ? 'true' : 'false'} hreflang="es" lang="es">ES</a>
      </div>
      <button class="themetoggle" type="button" aria-label={s.nav.theme} title={s.nav.theme}>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z" />
        </svg>
      </button>
    </div>
  </div>
</nav>
<script>
  // Flip the palette and remember the choice; the <head> script applies it on load.
  const btn = document.querySelector('.themetoggle');
  btn?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
</script>
